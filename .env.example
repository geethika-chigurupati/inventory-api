# Copy to .env or export these in your shell. Never commit real secrets.
DATABASE_URL=postgresql+psycopg://inventory:inventory@localhost:5432/inventory
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
